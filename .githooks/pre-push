#!/bin/sh
# Refuse to push commits authored or committed by anyone but the owner.
#
# This repo is pushed from several machines, including the bot committing on
# its own. Clones that never set a local identity fall back to the global one
# (a work address, or a hostname-derived default like
# user@Some-MacBook-Air.local), and those commits have landed on the remote
# before. Local config alone can't prevent that on a machine nobody has fixed
# yet, so gate it at the push.
#
# Enable per clone (do NOT set this globally — it would apply to every repo):
#   git config --local core.hooksPath .githooks
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>

ALLOWED_EMAIL="tackish@nate.com"
ZERO=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$ZERO" ] && continue # branch deletion

	if [ "$remote_sha" = "$ZERO" ]; then
		# New branch: check commits not already reachable from any other ref.
		range="$local_sha --not --remotes"
	else
		range="$remote_sha..$local_sha"
	fi

	# %ae/%ce rather than %aE/%cE: mailmap must not mask the real identity.
	bad=$(git log --format='%h %ae %ce %s' $range 2>/dev/null |
		awk -v ok="$ALLOWED_EMAIL" '$2 != ok || $3 != ok')

	if [ -n "$bad" ]; then
		echo "pre-push: refusing — commits not authored by $ALLOWED_EMAIL:" >&2
		echo "$bad" | sed 's/^/  /' >&2
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	cat >&2 <<EOF

Fix this clone's identity, then re-author the offending commits:
  git config --local user.name "Tek"
  git config --local user.email "$ALLOWED_EMAIL"
  git rebase --exec 'git commit --amend --no-edit --reset-author' <base>
EOF
fi

exit $status
